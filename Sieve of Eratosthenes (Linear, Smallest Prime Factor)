1.	#include <bits/stdc++.h>
2.	using namespace std;
3.	typedef long long ll;
4.	
5.	const int N = 1e6 + 5;
6.	int spf[N];
7.	vector<int> primes;
8.	
9.	void sieve() {
10.	    for (int i = 2; i < N; i++) {
11.	        if (!spf[i]) {
12.	            spf[i] = i;
13.	            primes.push_back(i);
14.	        }
15.	        for (int p : primes) {
16.	            if (p > spf[i] || (ll)i * p >= N) break;
17.	            spf[i * p] = p;
18.	        }
19.	    }
20.	}
21.	
22.	set<int> primeFactors(int a) {
23.	    set<int> res;
24.	    while (a > 1) {
25.	        res.insert(spf[a]);
26.	        a /= spf[a];
27.	    }
28.	    return res;
29.	}
