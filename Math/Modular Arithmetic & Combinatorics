1.	#include <bits/stdc++.h>
2.	using namespace std;
3.	typedef long long ll;
4.	
5.	const ll MOD = 1e9 + 7;
6.	
7.	ll power(ll x, ll y, ll m = MOD) {
8.	    x %= m;
9.	    if (x < 0) x += m;
10.	    ll res = 1;
11.	    while (y > 0) {
12.	        if (y & 1) res = res * x % m;
13.	        x = x * x % m;
14.	        y >>= 1;
15.	    }
16.	    return res;
17.	}
18.	
19.	ll modInverse(ll a, ll m = MOD) {
20.	    return power(a, m - 2, m);
21.	}
22.	
23.	ll add(ll a, ll b, ll m = MOD) { return ((a % m) + (b % m) + m) % m; }
24.	ll sub(ll a, ll b, ll m = MOD) { return ((a % m) - (b % m) + m) % m; }
25.	ll mul(ll a, ll b, ll m = MOD) { return (a % m) * (b % m) % m; }
26.	ll divide(ll a, ll b, ll m = MOD) { return mul(a, modInverse(b, m)); }
27.	
28.	const int MAXN = 1e6 + 5;
29.	ll fact[MAXN], invFact[MAXN];
30.	
31.	void precomputeFactorials() {
32.	    fact[0] = 1;
33.	    for (int i = 1; i < MAXN; i++)
34.	        fact[i] = fact[i - 1] * i % MOD;
35.	    invFact[MAXN - 1] = modInverse(fact[MAXN - 1]);
36.	    for (int i = MAXN - 2; i >= 0; i--)
37.	        invFact[i] = invFact[i + 1] * (i + 1) % MOD;
38.	}
39.	
40.	ll nCr(int n, int r) {
41.	    if (r < 0 || r > n) return 0;
42.	    return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;
43.	}
44.	
45.	ll nPr(int n, int r) {
46.	    if (r < 0 || r > n) return 0;
47.	    return fact[n] * invFact[n - r] % MOD;
48.	}
